#!/usr/bin/env python3
"""Pack, verify, and install retrace-libpython artifact bundles."""

import argparse
import hashlib
import io
import json
import lzma
import os
from pathlib import Path
import platform
import shutil
import subprocess
import tarfile
import tempfile


SCHEMA = 3
MODES = ("release", "debug")
MODE_FILES = (
    "python",
    "libpython.a",
    "pyconfig.h",
    "pybuilddir.txt",
    "retrace-libpython.json",
    "Makefile",
    "Makefile.pre",
    "config.status",
    "python-config",
    "python-config.py",
)


def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def git_output(root, *args):
    return subprocess.check_output(
        ("git", "-C", str(root), *args), text=True
    ).strip()


def platform_tag():
    system = platform.system().lower()
    if system == "darwin":
        system = "macos"
    machine = platform.machine().lower().replace("aarch64", "arm64")
    return f"{system}-{machine}"


def copy_source(source, destination):
    shutil.copytree(
        source,
        destination,
        ignore=shutil.ignore_patterns(".git", "__pycache__", "*.pyc"),
        symlinks=True,
    )


def write_launcher(mode_root):
    launcher = mode_root / "python-relocatable"
    launcher.write_text(
        "#!/bin/sh\n"
        "set -eu\n"
        "mode=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\n"
        "root=$(dirname -- \"$mode\")\n"
        "platlib=$(cat \"$mode/pybuilddir.txt\")\n"
        "export PYTHONHOME=\"$mode\"\n"
        "export PYTHONPATH=\"$root/source/Lib:$mode/$platlib"
        "${PYTHONPATH:+:$PYTHONPATH}\"\n"
        "exec \"$mode/python\" \"$@\"\n"
    )
    launcher.chmod(0o755)


def copy_mode(source, destination):
    destination.mkdir(parents=True)
    for name in MODE_FILES:
        path = source / name
        if name == "python" and not path.is_file():
            path = source / "python.exe"
        if path.exists():
            if path.is_symlink():
                destination.joinpath(name).symlink_to(os.readlink(path))
            else:
                shutil.copy2(path, destination / name)
    build_dir = source / "build"
    if not build_dir.is_dir():
        raise SystemExit(f"missing CPython build directory: {build_dir}")
    shutil.copytree(
        build_dir,
        destination / "build",
        ignore=shutil.ignore_patterns("*.o", "__pycache__", "*.pyc"),
        symlinks=False,
    )
    write_launcher(destination)


def load_mode_metadata(version_root, mode):
    path = version_root / mode / "retrace-libpython.json"
    try:
        return json.loads(path.read_text())
    except FileNotFoundError as error:
        raise SystemExit(f"missing build metadata: {path}") from error


def file_inventory(root):
    inventory = {}
    for path in sorted(root.rglob("*")):
        if path.is_file() and not path.is_symlink():
            inventory[path.relative_to(root).as_posix()] = {
                "sha256": sha256(path),
                "size": path.stat().st_size,
            }
    return inventory


def normalized_tar_info(info):
    info.uid = 0
    info.gid = 0
    info.uname = ""
    info.gname = ""
    info.mtime = 0
    return info


def create_archive(source, output):
    output.parent.mkdir(parents=True, exist_ok=True)
    with lzma.open(
        output,
        mode="wb",
        format=lzma.FORMAT_XZ,
        preset=9 | lzma.PRESET_EXTREME,
    ) as compressed:
        with tarfile.open(
            mode="w|", fileobj=compressed, format=tarfile.PAX_FORMAT
        ) as archive:
            add_tree(archive, source)


def add_tree(archive, source, prefix=""):
    for path in sorted(source.iterdir(), key=lambda item: item.name):
        name = f"{prefix}/{path.name}" if prefix else path.name
        archive.add(path, arcname=name, filter=normalized_tar_info)


def add_bytes(archive, name, data):
    info = tarfile.TarInfo(name)
    info.size = len(data)
    info.mode = 0o644
    normalized_tar_info(info)
    archive.addfile(info, io.BytesIO(data))


def command_pack(args):
    root = args.root.resolve()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    repository = Path(__file__).resolve().parents[1]
    requested_versions = args.versions
    if len(requested_versions) != 1:
        raise SystemExit("exact artifacts require exactly one CPython version")
    version_records = {}
    profiles = set()
    producer_commit = args.producer_commit
    if len(producer_commit) != 40 or any(
        character not in "0123456789abcdef" for character in producer_commit
    ):
        raise SystemExit(f"invalid producer commit: {producer_commit}")
    try:
        dirty = git_output(repository, "status", "--porcelain")
    except subprocess.CalledProcessError:
        dirty = ""
    if dirty:
        raise SystemExit("refusing to pack from a dirty producer checkout")
    for version in requested_versions:
        version_root = root / f"v{version}"
        metadata = {
            mode: load_mode_metadata(version_root, mode) for mode in MODES
        }
        versions = {item["cpython"]["version"] for item in metadata.values()}
        commits = {item["cpython"]["commit"] for item in metadata.values()}
        mode_profiles = {item["profile"] for item in metadata.values()}
        if versions != {version} or len(commits) != 1 or len(mode_profiles) != 1:
            raise SystemExit(
                f"release and debug metadata identities do not match for {version}"
            )
        profiles.update(mode_profiles)
        version_records[version] = {
            "commit": commits.pop(),
            "modes": metadata,
        }
    if len(profiles) != 1:
        raise SystemExit("all versions must use the same build profile")

    inventory = {}
    with lzma.open(
        args.output,
        mode="wb",
        format=lzma.FORMAT_XZ,
        preset=9 | lzma.PRESET_EXTREME,
    ) as compressed:
        with tarfile.open(
            mode="w|", fileobj=compressed, format=tarfile.PAX_FORMAT
        ) as archive:
            with tempfile.TemporaryDirectory(dir=args.output.parent) as temporary:
                temporary_root = Path(temporary)
                for version in requested_versions:
                    source_root = root / f"v{version}"
                    stage = temporary_root / f"v{version}"
                    copy_source(source_root / "source", stage / "source")
                    for mode in MODES:
                        copy_mode(source_root / mode, stage / mode)
                    for relative, record in file_inventory(stage).items():
                        inventory[f"v{version}/{relative}"] = record
                    add_tree(archive, stage, f"v{version}")
                    shutil.rmtree(stage)
            manifest = {
                "schema": SCHEMA,
                "kind": "exact",
                "producer": {
                    "version": args.producer_version,
                    "commit": producer_commit,
                },
                "profile": profiles.pop(),
                "platform": platform_tag(),
                "versions": version_records,
                "files": inventory,
            }
            manifest_data = (
                json.dumps(manifest, indent=2, sort_keys=True) + "\n"
            ).encode()
            add_bytes(
                archive, "retrace-libpython-manifest.json", manifest_data
            )
    print(args.output)


def safe_extract(archive_path, destination):
    destination = destination.resolve()
    with tarfile.open(archive_path, "r:xz") as archive:
        for member in archive.getmembers():
            target = (destination / member.name).resolve()
            if target != destination and destination not in target.parents:
                raise SystemExit(f"unsafe archive member: {member.name}")
        archive.extractall(destination)


def verify_tree(root, run=False, expected_versions=None):
    manifest_path = root / "retrace-libpython-manifest.json"
    manifest = json.loads(manifest_path.read_text())
    if manifest.get("schema") != SCHEMA:
        raise SystemExit(f"unsupported artifact schema: {manifest.get('schema')}")
    if manifest.get("platform") != platform_tag():
        raise SystemExit(
            f"artifact platform {manifest.get('platform')} does not match {platform_tag()}"
        )
    actual_versions = set(manifest.get("versions", {}))
    if manifest.get("kind") != "exact" or len(actual_versions) != 1:
        raise SystemExit("invalid exact artifact identity")
    if expected_versions is not None and actual_versions != set(expected_versions):
        missing = sorted(set(expected_versions) - actual_versions)
        extra = sorted(actual_versions - set(expected_versions))
        raise SystemExit(
            f"artifact version mismatch; missing={missing}, extra={extra}"
        )
    expected = manifest["files"]
    for relative, record in expected.items():
        path = root / relative
        if not path.is_file():
            raise SystemExit(f"missing artifact file: {relative}")
        if path.stat().st_size != record["size"] or sha256(path) != record["sha256"]:
            raise SystemExit(f"artifact checksum mismatch: {relative}")
    if run:
        for version_value in manifest["versions"]:
            version = tuple(int(part) for part in version_value.split("."))
            probe = (
                "import _lzma, _ssl, sys; "
                f"assert sys.version_info[:3] == {version!r}; "
                "assert hasattr(sys, 'gettotalrefcount') == "
            )
            for mode in MODES:
                expression = probe + ("True" if mode == "debug" else "False")
                subprocess.run(
                    [root / f"v{version_value}" / mode / "python-relocatable",
                     "-c", expression],
                    check=True,
                )
    return manifest


def command_verify(args):
    if args.archive:
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary) / "payload"
            root.mkdir()
            safe_extract(args.archive, root)
            manifest = verify_tree(root, args.run, args.versions)
    else:
        manifest = verify_tree(args.root.resolve(), args.run, args.versions)
    print(
        f"verified {len(manifest['versions'])} CPython patch releases "
        f"for {manifest['platform']} ({manifest['producer']['version']})"
    )


def command_install(args):
    destination = args.destination.resolve()
    destination.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=destination.parent) as temporary:
        stage = Path(temporary) / "payload"
        stage.mkdir()
        safe_extract(args.archive, stage)
        verify_tree(stage, args.run, args.versions)
        managed_names = [path.name for path in stage.iterdir()]
        existing = [name for name in managed_names if (destination / name).exists()]
        if existing and not args.force:
            raise SystemExit(
                "artifact paths already exist in destination: " + ", ".join(existing)
            )
        for name in existing:
            path = destination / name
            if path.is_dir():
                shutil.rmtree(path)
            else:
                path.unlink()
        for path in stage.iterdir():
            os.replace(path, destination / path.name)
    print(destination)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(required=True)

    platform_parser = subparsers.add_parser("platform-tag")
    platform_parser.set_defaults(func=lambda args: print(platform_tag()))

    pack = subparsers.add_parser("pack")
    pack.add_argument("--root", required=True, type=Path)
    pack.add_argument("--versions", nargs="+", required=True)
    pack.add_argument("--output", required=True, type=Path)
    pack.add_argument("--producer-version", required=True)
    pack.add_argument("--producer-commit", required=True)
    pack.set_defaults(func=command_pack)

    verify = subparsers.add_parser("verify")
    source = verify.add_mutually_exclusive_group(required=True)
    source.add_argument("--archive", type=Path)
    source.add_argument("--root", type=Path)
    verify.add_argument("--run", action="store_true")
    verify.add_argument("--versions", nargs="+")
    verify.set_defaults(func=command_verify)

    install = subparsers.add_parser("install")
    install.add_argument("--archive", required=True, type=Path)
    install.add_argument("--destination", required=True, type=Path)
    install.add_argument("--force", action="store_true")
    install.add_argument("--run", action="store_true")
    install.add_argument("--versions", nargs="+")
    install.set_defaults(func=command_install)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
