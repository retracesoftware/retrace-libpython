#!/bin/sh
set -eu

usage() {
    echo "usage: scripts/registry exists|digest REFERENCE | push|pull REFERENCE ARCHIVE" >&2
    exit 2
}

command=${1:-}
reference=${2:-}
archive=${3:-}
[ -n "$command" ] && [ -n "$reference" ] || usage
command -v oras >/dev/null 2>&1 || {
    echo "oras is required for GHCR transport" >&2
    exit 127
}

media_type=application/vnd.retracesoftware.libpython.bundle.v3+xz
case "$command" in
    exists)
        [ -z "$archive" ] || usage
        oras manifest fetch "$reference" >/dev/null
        ;;
    digest)
        [ -z "$archive" ] || usage
        oras manifest fetch --descriptor "$reference" |
            python3 -c 'import json, sys; print(json.load(sys.stdin)["digest"])'
        ;;
    push)
        [ -n "$archive" ] || usage
        if oras manifest fetch "$reference" >/dev/null 2>&1; then
            echo "refusing to replace existing artifact: $reference" >&2
            exit 1
        fi
        archive_directory=$(dirname -- "$archive")
        archive_directory=$(unset CDPATH; cd -- "$archive_directory" && pwd)
        archive_name=$(basename -- "$archive")
        cd "$archive_directory"
        oras push "$reference" \
            --artifact-type application/vnd.retracesoftware.libpython.v1 \
            --annotation org.opencontainers.image.source=https://github.com/retracesoftware/retrace-libpython \
            "$archive_name:$media_type"
        ;;
    pull)
        [ -n "$archive" ] || usage
        destination=$(dirname -- "$archive")
        mkdir -p "$destination"
        temporary=$(mktemp -d "$destination/.oras.XXXXXX")
        trap 'rm -rf "$temporary"' EXIT HUP INT TERM
        oras pull "$reference" --output "$temporary"
        pulled="$temporary/$(basename -- "$archive")"
        [ -f "$pulled" ] || {
            echo "artifact did not contain $(basename -- "$archive")" >&2
            exit 1
        }
        mv "$pulled" "$archive"
        ;;
    *) usage ;;
esac
